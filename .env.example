# Serveur
PORT=3000
BASE_URL=http://localhost:3000

# Clé attendue dans l'en-tête x-api-key de chaque requête
API_KEY=

# Origines autorisées à appeler l'API, séparées par des virgules.
# À mettre à jour si l'URL du front change (nouveau projet Vercel).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SMTP (Mailtrap en développement)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
