# URL de base de l'API — doit se terminer par /api
# En développement : http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# Clé envoyée dans l'en-tête x-api-key à chaque requête.
# Doit être identique à API_KEY côté serveur.
#
# Note : les variables VITE_* sont intégrées au build et donc lisibles
# dans les fichiers téléchargés par le navigateur. Cette clé n'est pas
# un secret : elle filtre les appels opportunistes, la protection réelle
# vient du CORS et de la limitation de débit côté API.
VITE_API_KEY=
